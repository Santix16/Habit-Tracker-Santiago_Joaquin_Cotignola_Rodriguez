{
    "name": "my-angular-app",
    "version": "0.0.0",
    "main": "main.js",
    "build": {
        "appId": "org.iescamp.din.my-angular-app",
        "productName": "Mi Aplicación Angular",
        "files": [
            "dist/my-angular-app/**/*",
            "main.js",
            "package.json"
        ]
    },
    "win": {
        "target": [
            "nsis"
        ]
    },
    "linux": {
        "target": [
            "AppImage"
        ]
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "dev": "npm-run-all --parallel electron start",
        "electron": "wait-on tcp:4200 && ng build --base-href ./ && electron .",
        "package": "ng build && electron-builder",
        "package-win": "ng build && electron-builder --win",
        "package-linux": "ng build && electron-builder --linux"
    },
    "prettier": {
        "printWidth": 100,
        "singleQuote": true,
        "overrides": [
            {
                "files": "*.html",
                "options": {
                    "parser": "angular"
                }
            }
        ]
    },
    "private": true,
    "dependencies": {
        "@angular/common": "^20.2.0",
        "@angular/compiler": "^20.2.0",
        "@angular/core": "^20.2.0",
        "@angular/forms": "^20.2.0",
        "@angular/platform-browser": "^20.2.0",
        "@angular/router": "^20.2.0",
        "json-server": "^1.0.0-beta.3",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.15.0"
    },
    "devDependencies": {
        "@angular/build": "^20.2.2",
        "@angular/cli": "^20.2.2",
        "@angular/compiler-cli": "^20.2.0",
        "@types/jasmine": "~5.1.0",
        "electron": "^38.0.0",
        "electron-builder": "^26.0.12",
        "jasmine-core": "~5.9.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "npm-run-all": "^4.1.5",
        "typescript": "~5.9.2",
        "wait-on": "^8.0.4"
    },
    "description": "This project was generated using [Angular CLI](https://github.com/angular/angular-cli) version 20.3.8.",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs"
}
